{
  "name": "persona-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-widget.mjs && next build",
    "build:widget": "node scripts/build-widget.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:link": "dotenv -e .env.local -- supabase link --project-ref $SUPABASE_PROJECT_REF",
    "db:push": "dotenv -e .env.local -- supabase db push",
    "db:pull": "dotenv -e .env.local -- supabase db pull",
    "db:types": "dotenv -e .env.local -- supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "db:projects": "dotenv -e .env.local -- supabase projects list",
    "acs:bootstrap": "npx tsx --env-file=.env.local scripts/acs-bootstrap.ts",
    "acs:purge": "npx tsx --env-file=.env.local scripts/acs-purge-connection.ts",
    "acs:doctor": "npx tsx --env-file=.env.local scripts/acs-doctor.ts",
    "sizing:research": "npx tsx --env-file=.env.local scripts/sizing-research-dry-run.ts",
    "sizing:seed": "npx tsx --env-file=.env.local scripts/seed-sizing-charts.ts",
    "setup:stripe": "dotenv -e .env.local -- node scripts/setup-stripe-catalog.mjs",
    "generate:backdrops": "dotenv -e .env.local -- node scripts/generate-backdrop-plates.mjs"
  },
  "dependencies": {
    "@decartai/sdk": "^0.1.17",
    "@google/genai": "^2.10.0",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "google-auth-library": "^10.9.0",
    "gray-matter": "^4.0.3",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "postcss": "^8.5.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.1",
    "resend": "^6.16.0",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "supabase": "^2.109.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
